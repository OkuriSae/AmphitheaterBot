DISCORD_TOKEN=your_bot_token_here

# Optional: set this while developing to make slash command updates appear quickly
# in one server. Leave empty for global commands.
DISCORD_GUILD_ID=

# Optional: Google Sheets CSV export URL with userid and rating columns.
RATINGS_CSV_URL=https://docs.google.com/spreadsheets/d/13__lGAuvm00wKJeZro8hGpy9PsulrCHvDiCVxdly7qU/export?format=csv&gid=0
MEMBER_LIST_URL=https://docs.google.com/spreadsheets/d/13__lGAuvm00wKJeZro8hGpy9PsulrCHvDiCVxdly7qU/edit#gid=0
RESULT_TABLE_URL=https://docs.google.com/spreadsheets/d/13__lGAuvm00wKJeZro8hGpy9PsulrCHvDiCVxdly7qU/edit?gid=510962199#gid=510962199

# Required to append missing users to Google Sheets.
# Create a Google Cloud service account JSON key, share the sheet with its client_email,
# then set this to the local JSON file path.
GOOGLE_SERVICE_ACCOUNT_FILE=/absolute/path/to/service-account.json
